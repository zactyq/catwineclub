# NocoDB (see docker-compose.yml at the repo root). Run `npm run setup:nocodb`
# after `docker compose up -d` to provision the base/tables and fill in the
# NOCODB_* values below automatically — this file only documents them.
NOCODB_URL=http://localhost:8081
NOCODB_API_TOKEN=
NOCODB_BASE_ID=
NOCODB_TABLE_WINE_LISTINGS=
NOCODB_TABLE_WINE_CLAIMS=
NOCODB_TABLE_EVENTS=
NOCODB_TABLE_EVENT_SIGNUPS=
NOCODB_TABLE_MEMBERSHIP_APPLICATIONS=

# Better Auth (magic-link sign-in, 1-year sessions)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Comma-separated list of emails that get admin access (approve members,
# post wines/events as admin, see /admin).
ADMIN_EMAILS=

# Optional: send real magic-link emails via Resend. Without this, links are
# printed to the dev server console instead.
RESEND_API_KEY=
EMAIL_FROM="Cat Wine Club <onboarding@resend.dev>"
