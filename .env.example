# Used by docker-compose.yml at the repo root (copy to .env, not committed).
# cloudflared itself runs as a native macOS service (installed via
# `cloudflared service install <token>`, not part of this compose file) —
# manage/rotate that tunnel from the Cloudflare Zero Trust dashboard.

# Once the tunnel is live, set this to the public hostname so NocoDB builds
# correct absolute URLs (attachments, etc).
NOCODB_PUBLIC_URL=https://db.catwine.club

# Optional overrides — defaults are fine for local dev.
NOCODB_ADMIN_EMAIL=admin@catwineclub.local
NOCODB_ADMIN_PASSWORD=changeme123!
