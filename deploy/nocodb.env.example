# Copy to nocodb.env on the server and fill in. Consumed by the `nocodb` service.
# With an existing noco.db (migrated volume) the admin user already exists; these
# only matter for a fresh init, but keep them consistent anyway.
NC_ADMIN_EMAIL=
NC_ADMIN_PASSWORD=
NC_PUBLIC_URL=https://db.catwineclub.tanisaac.com
