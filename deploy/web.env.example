# Copy to web.env on the server and fill in. Consumed by the `web` service.
NODE_ENV=production

# Keep BETTER_AUTH_SECRET identical to the previous deployment so existing
# sessions in auth.db stay valid.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://catwineclub.tanisaac.com
NEXT_PUBLIC_BETTER_AUTH_URL=https://catwineclub.tanisaac.com
ADMIN_EMAILS=

# Server-to-server calls go over the internal compose network; browser-facing
# attachment URLs use the public hostname.
NOCODB_URL=http://nocodb:8080
NOCODB_PUBLIC_URL=https://db.catwineclub.tanisaac.com
NOCODB_API_TOKEN=
NOCODB_BASE_ID=
NOCODB_TABLE_WINE_LISTINGS=
NOCODB_TABLE_WINE_CLAIMS=
NOCODB_TABLE_EVENTS=
NOCODB_TABLE_EVENT_SIGNUPS=
NOCODB_TABLE_MEMBERSHIP_APPLICATIONS=
NOCODB_TABLE_ADMINS=
NOCODB_TABLE_EVENT_WINES=
NOCODB_TABLE_WINE_REVIEWS=
NOCODB_TABLE_EVENT_PHOTOS=

RESEND_API_KEY=
EMAIL_FROM="Cat Wine Club <noreply@mail.catwine.club>"
